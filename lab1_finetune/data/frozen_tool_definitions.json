[
  {
    "name": "search_products",
    "description": "Tìm AI Server và AI Workstation trong danh mục sản phẩm theo bộ lọc có cấu trúc.",
    "parameters": {
      "$defs": {
        "ProductFilter": {
          "additionalProperties": false,
          "properties": {
            "min_ram_gb": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Ram Gb"
            },
            "min_gpu_count": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Gpu Count"
            },
            "max_base_price_vnd": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Max Base Price Vnd"
            },
            "product_type": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProductType"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "title": "ProductFilter",
          "type": "object"
        },
        "ProductType": {
          "enum": [
            "ai_server",
            "ai_workstation"
          ],
          "title": "ProductType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "filters": {
          "$ref": "#/$defs/ProductFilter"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "SearchProductsArgs",
      "type": "object"
    }
  },
  {
    "name": "get_product",
    "description": "Lấy thông tin một nền tảng sản phẩm theo mã sản phẩm.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "product_id"
      ],
      "title": "GetProductArgs",
      "type": "object"
    }
  },
  {
    "name": "search_product_documents",
    "description": "Tìm bằng chứng kỹ thuật trong tài liệu của sản phẩm, có thể giới hạn theo mã sản phẩm.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "top_k": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchProductDocumentsArgs",
      "type": "object"
    }
  },
  {
    "name": "compare_products",
    "description": "So sánh thông tin catalog của nhiều nền tảng sản phẩm.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "product_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Product Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids"
      ],
      "title": "CompareProductsArgs",
      "type": "object"
    }
  },
  {
    "name": "compare_configurations",
    "description": "So sánh các cấu hình AI Server hoặc AI Workstation đã tạo.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "configuration_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Configuration Ids",
          "type": "array"
        }
      },
      "required": [
        "configuration_ids"
      ],
      "title": "CompareConfigurationsArgs",
      "type": "object"
    }
  },
  {
    "name": "estimate_ai_requirements",
    "description": "Ước lượng nhu cầu VRAM, RAM và tài nguyên cho workload AI theo quy tắc deterministic.",
    "parameters": {
      "$defs": {
        "UsageType": {
          "enum": [
            "inference",
            "fine_tune"
          ],
          "title": "UsageType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "model_parameters_b": {
          "exclusiveMinimum": 0,
          "title": "Model Parameters B",
          "type": "number"
        },
        "usage": {
          "$ref": "#/$defs/UsageType"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "context_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Length"
        },
        "concurrent_users": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concurrent Users"
        },
        "training_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Method"
        }
      },
      "required": [
        "model_parameters_b",
        "usage"
      ],
      "title": "EstimateAIRequirementsArgs",
      "type": "object"
    }
  }
]
