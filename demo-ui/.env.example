# Loaded only by the Next.js server process. Keep Gateway credentials out of browser code.
LAB2_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
LAB2_OPENCLAW_GATEWAY_TOKEN=replace-with-the-private-openclaw-gateway-token

# Lab 3 API origin; browser requests remain same-origin through the Next.js rewrite.
BACKEND_URL=http://127.0.0.1:8000

# Conversation POST only: two 60-second model calls plus 15 seconds overhead.
# Positive integer <= 135000. Workflow SSE and other rewrite routes are unchanged.
LAB3_CONVERSATION_TIMEOUT_MS=135000

# Explanation POST only: one provider/model call plus proxy overhead.
# Positive integer <= 75000.
LAB3_EXPLANATION_TIMEOUT_MS=75000
