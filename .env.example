# Local Lab 2 PostgreSQL only. Replace the placeholder before starting Docker.
LAB2_POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
LAB2_POSTGRES_DSN=postgresql://lab2:${LAB2_POSTGRES_PASSWORD}@127.0.0.1:5432/lab2_catalog

# The integration test creates/drops a uniquely named temporary schema.
LAB2_TEST_POSTGRES_DSN=${LAB2_POSTGRES_DSN}

# WeKnora is a separate local service; its API key is a placeholder only.
WEKNORA_BASE_URL=http://127.0.0.1:8080
WEKNORA_API_KEY=replace-with-a-weknora-api-key
WEKNORA_KNOWLEDGE_BASE_ID=replace-with-an-existing-document-kb-id
